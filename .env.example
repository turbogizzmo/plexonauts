# Copy to .env (mode 600) on the Plex host. Never commit the real file.
# Keep comments on their own lines.
TAUTULLI_URL=http://localhost:8181
# Tautulli > Settings > Web Interface > API key
TAUTULLI_API_KEY=
PLEX_URL=http://localhost:32400
# Preferences.xml PlexOnlineToken, or plex.tv
PLEX_TOKEN=
PLEX_LOG=/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Logs/Plex Media Server.log

# see README: this feed exposes real usernames
BIND_HOST=127.0.0.1
BIND_PORT=8787
POLL_SECONDS=4
# seconds of no real navigation before a user goes idle
BROWSE_TTL=45
# peak observed concurrency on this server is 7
COUCHES=8

# Extra Host names and browser Origins the viewer may be opened from, comma
# separated. IP addresses, localhost, single-label names (plex), LAN-only
# names (plex.lan, plex.local, plex.home.arpa, ...) and this machine's own
# hostname already work, and the feed accepts the page it served, so these are
# only needed for a public DNS name or a reverse proxy. Add "null" to
# ALLOWED_ORIGINS to use viewer.html from file://.
# ALLOWED_HOSTS=plex.example.com
# ALLOWED_ORIGINS=https://plex.example.com
