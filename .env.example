# Copy to .env (mode 600) on the Plex host. Never commit the real file.
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=          # Tautulli > Settings > Web Interface > API key
PLEX_URL=http://localhost:32400
PLEX_TOKEN=                # Preferences.xml PlexOnlineToken, or plex.tv
PLEX_LOG=/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Logs/Plex Media Server.log

BIND_HOST=127.0.0.1        # see README: this feed exposes real usernames
BIND_PORT=8787
POLL_SECONDS=4
BROWSE_TTL=45              # seconds of no real navigation before a user goes idle
COUCHES=8                  # peak observed concurrency on this server is 7
